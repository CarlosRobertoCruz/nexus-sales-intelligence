# Configuracao do servidor. Copie para .env.vps; nao versione o arquivo preenchido.
# Credenciais Hubsoft ficam SOMENTE no .env, lido pelo servico api/migrate.
APP_ORIGIN=https://sales.nexusfibra.net.br
# Use a senha real, com caracteres especiais codificados para URL.
# 5432 e a porta INTERNA de lab-postgres. A porta 5433 e do host da VPS.
DATABASE_URL=postgresql://lab:SUBSTITUA_A_SENHA@lab-postgres:5432/lab
APP_VERSION=local
TRAEFIK_NETWORK=n8n-traefik_app_network
DATABASE_NETWORK=lab_network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
SALES_DOMAIN=sales.nexusfibra.net.br
